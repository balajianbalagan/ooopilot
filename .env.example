# ---------- Slack ----------
# xoxb-... (OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN=
# xapp-... (Basic Information -> App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN=
# Basic Information -> Signing Secret (not needed in Socket Mode, kept for HTTP mode)
SLACK_SIGNING_SECRET=

# ---------- Jira ----------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PHX

# ---------- CALL-E ----------
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# Public URL where CALL-E posts terminal call events (ngrok during the demo)
CALLE_WEBHOOK_URL=
# Optional: override the region/locale derived from the phone number
CALLE_REGION=
CALLE_LOCALE=

# ---------- LLM (OpenAI) ----------
# Either name works; OPENAI_API_KEY is accepted as an alias.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- Demo phone numbers (E.164) ----------
# Use numbers you are authorized to call, e.g. +9198XXXXXXXX
ARUN_PHONE=
RAJ_PHONE=

# ---------- Server ----------
PORT=3000
# Set to true to run the whole flow without spending CALL-E credits
CALLE_DRY_RUN=false

# Optional: scope the sync, e.g. project = KAN AND labels = "ooo-caller-demo" ORDER BY updated DESC
JIRA_JQL=
